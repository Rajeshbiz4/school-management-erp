APP_NAME=School ERP Backend API
APP_ENV=local
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Beginner mode: true = run without Azure Cosmos DB.
# After Cosmos DB is ready, set this to false and fill the Cosmos values below.
USE_IN_MEMORY_DB=true

COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key
COSMOS_DATABASE_NAME=school_erp_db
COSMOS_EMPLOYEE_CONTAINER=employees
COSMOS_MAINTENANCE_CONTAINER=maintenance_tickets
